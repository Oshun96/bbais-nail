# BBAIS Nail Platform - backend environment.
# Copy to backend/.env and fill in. NEVER commit .env (VULN-CRED-01).

MONGO_URL=
DB_NAME=bbais_nail

# Explicit CORS allowlist, comma separated. "*" is rejected at boot.
CORS_ORIGINS=http://localhost:5173

# Which shop this deployment serves when a request names none.
DEFAULT_SHOP_SLUG=lacquer-and-lume

# Admin gate for config edits. Unset = admin endpoints fail closed.
ADMIN_API_KEY=

PORT=8080

# --- Payments -------------------------------------------------------------
# Per shop: PAY_<SLUG>_<PROCESSOR>_<FIELD>   (slug uppercased, dashes -> _)
# Shared fallback for a single-shop deployment: PAY_<PROCESSOR>_<FIELD>
# ENV defaults to sandbox; set it to "live" only when you mean real money.
#
# PAY_LACQUER_AND_LUME_PAYPAL_CLIENT_ID=
# PAY_LACQUER_AND_LUME_PAYPAL_CLIENT_SECRET=
# PAY_LACQUER_AND_LUME_PAYPAL_ENV=sandbox
#
# PAY_MAISON_RUBY_STRIPE_SECRET_KEY=
# PAY_MAISON_RUBY_STRIPE_PUBLISHABLE_KEY=
#
# PAY_<SLUG>_SQUARE_ACCESS_TOKEN=
# PAY_<SLUG>_SQUARE_APPLICATION_ID=
# PAY_<SLUG>_SQUARE_LOCATION_ID=
